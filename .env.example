# Docker Compose development database
POSTGRES_DB=certchain
POSTGRES_USER=certchain
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Development SMTP inbox (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Copy the component-specific templates too:
