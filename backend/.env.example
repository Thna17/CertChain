# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/certchain
DATABASE_USERNAME=certchain
DATABASE_PASSWORD=change-me-for-local-development

# HTTP and browser origin
SERVER_PORT=8080
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT (used from the authentication phase; generate at least 32 random bytes)
JWT_SECRET_BASE64=replace-with-a-base64-encoded-random-secret
JWT_ACCESS_TOKEN_TTL=PT15M

# Generated artifacts
STORAGE_ROOT=./storage

# Development email (Mailpit defaults)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=certificates@certchain.local

# Ethereum - leave disabled until a local contract or Sepolia is configured
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ISSUER_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=2

